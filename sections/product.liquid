{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign breadcrumb_collection = collection | default: product.collections.first
  assign free_shipping_threshold_money = section.settings.free_shipping_threshold | times: 100 | money
%}

<div class="product">
  {% render 'product-media-gallery', product: product %}

  <div class="product__info">
    {% if breadcrumb_collection or product.type != blank %}
      <div class="product__breadcrumb text-label-caps">
        {% if breadcrumb_collection %}
          <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
        {% endif %}
        {% if breadcrumb_collection and product.type != blank %}
          <span class="product__breadcrumb-separator" aria-hidden="true">/</span>
        {% endif %}
        {% if product.type != blank %}
          <span class="product__breadcrumb-current">{{ product.type }}</span>
        {% endif %}
      </div>
    {% endif %}

    <h1 class="product__title text-headline-md">{{ product.title }}</h1>

    <p class="product__price text-body-lg" data-product-price>
      {% if current_variant.compare_at_price > current_variant.price %}
        <span class="product__price-sale" data-price-sale>{{ current_variant.price | money }}</span>
        <span class="product__price-compare" data-price-compare>{{ current_variant.compare_at_price | money }}</span>
        <span class="product__visually-hidden">{{ 'products.on_sale' | t }}</span>
      {% else %}
        <span data-price-regular>{{ current_variant.price | money }}</span>
      {% endif %}
    </p>

    {% render 'product-variant-picker', product: product %}

    <div class="product-form">
      {% form 'product', product, data-product-form: true %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="product-form__submit text-label-lg" data-product-form-submit>
          {{ 'products.add_to_bag' | t }}
        </button>
        {{ form | payment_button }}
      {% endform %}

      {% if section.settings.free_shipping_threshold > 0 %}
        <p class="product-form__shipping-note text-label-sm">
          {{ 'products.shipping_note' | t: threshold: free_shipping_threshold_money }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="product__accordion">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .product {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing-unit) * 6);
    padding-top: calc(var(--spacing-unit) * 6);
    padding-bottom: var(--spacing-section-gap);
  }

  .product__info {
    display: flex;
    flex-direction: column;
  }

  .product__breadcrumb {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 1);
    margin-bottom: calc(var(--spacing-unit) * 3);
    color: var(--color-on-surface-variant);
  }

  .product__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .product__breadcrumb a:hover {
    color: var(--color-on-surface);
  }

  .product__breadcrumb-separator {
    opacity: 0.5;
    font-size: 10px;
  }

  .product__breadcrumb-current {
    color: var(--color-primary);
  }

  .product__title {
    margin: 0 0 calc(var(--spacing-unit) * 1);
    color: var(--color-on-surface);
  }

  .product__price {
    margin: 0 0 calc(var(--spacing-unit) * 5);
    color: var(--color-on-surface-variant);
  }

  .product__price-sale {
    color: var(--color-primary);
    margin-right: calc(var(--spacing-unit) * 1);
  }

  .product__price-compare {
    text-decoration: line-through;
    color: var(--color-on-surface-variant);
  }

  .product__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .product-form {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 2);
    margin-top: calc(var(--spacing-unit) * 5);
  }

  .product-form__submit {
    display: block;
    width: 100%;
    padding: calc(var(--spacing-unit) * 2);
    border: none;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
    transition: opacity var(--motion-fade);
  }

  .product-form__submit:hover {
    opacity: 0.9;
  }

  .product-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .product-form__shipping-note {
    text-align: center;
    color: var(--color-on-surface-variant);
  }

  .product__accordion {
    margin-top: calc(var(--spacing-unit) * 6);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  @media (min-width: 1024px) {
    .product {
      grid-template-columns: 2fr 1fr;
      gap: calc(var(--spacing-unit) * 8);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-product-form]').forEach((form) => {
    const submitButton = form.querySelector('[data-product-form-submit]');

    form.addEventListener('submit', (event) => {
      if (!window.fetch) return;
      event.preventDefault();

      if (submitButton) submitButton.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      })
        .then((response) => {
          if (!response.ok) throw new Error('add_to_cart_failed');
          return fetch('/cart.js');
        })
        .then((response) => response.json())
        .then((cart) => {
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
        })
        .catch(() => {
          form.submit();
        })
        .finally(() => {
          if (submitButton) submitButton.disabled = false;
        });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "t:labels.free_shipping_threshold",
      "default": 100
    }
  ],
  "blocks": [{ "type": "product-detail" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
