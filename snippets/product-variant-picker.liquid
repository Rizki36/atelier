{% doc %}
  Renders the product variant picker: a circular swatch button per
  color-type option value, and a rectangular chip button for every
  other option (size, etc). Its own script resolves the selected
  variant client-side, updates the price and the cart form's hidden
  `id` input, reflects the choice in the URL, disables option
  combinations that have no matching available variant, and dispatches
  a `pdp:variant-change` event so other components (the media gallery)
  can react to the new variant without a page reload.

  @param {product} product - The product whose variants should be selectable

  @example
  {% render 'product-variant-picker', product: product %}
{% enddoc %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}

<div class="variant-picker" data-variant-picker>
  {% for option in product.options_with_values %}
    {% assign option_index = forloop.index0 %}
    {% assign is_color = false %}
    {% if option.name == 'Color' or option.name == 'Colour' %}
      {% assign is_color = true %}
    {% endif %}

    <div class="variant-picker__option{% if is_color %} variant-picker__option--color{% endif %}">
      <div class="variant-picker__label-row">
        <p class="variant-picker__label text-label-caps">
          {{ option.name }}
          {% if is_color %}
            <span class="variant-picker__selected-value" data-variant-selected-value>{{ current_variant.options[option_index] }}</span>
          {% endif %}
        </p>
      </div>

      <div class="variant-picker__values" data-variant-option data-option-index="{{ option_index }}">
        {% for value in option.values %}
          <button
            type="button"
            class="variant-picker__value-button{% if is_color %} variant-picker__swatch{% else %} variant-picker__chip{% endif %}{% if current_variant.options[option_index] == value %} is-active{% endif %}"
            data-option-value="{{ value | escape }}"
            aria-pressed="{% if current_variant.options[option_index] == value %}true{% else %}false{% endif %}"
          >
            {% if is_color %}
              <span class="variant-picker__swatch-color" style="background-color: {{ value | escape }};"></span>
              <span class="variant-picker__visually-hidden">{{ value }}</span>
            {% else %}
              {{ value }}
            {% endif %}
          </button>
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  <script type="application/json" data-variant-picker-json>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | money | json }},
          "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "featuredMediaId": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</div>

{% stylesheet %}
  .variant-picker__option {
    margin-bottom: var(--spacing-unit);
    padding-bottom: calc(var(--spacing-unit) * 4);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .variant-picker__label-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .variant-picker__label {
    color: var(--color-on-surface);
    margin: 0;
  }

  .variant-picker__selected-value {
    color: var(--color-on-surface-variant);
    text-transform: none;
    letter-spacing: normal;
    margin-left: var(--spacing-unit);
  }

  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 1.5);
  }

  .variant-picker__value-button {
    font-family: var(--font-body);
    background: none;
    cursor: pointer;
    color: var(--color-on-surface);
    transition: border-color var(--motion-fade), background-color var(--motion-fade), opacity var(--motion-fade);
  }

  .variant-picker__swatch {
    width: 32px;
    height: 32px;
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 50%;
  }

  .variant-picker__swatch:hover {
    border-color: var(--color-outline);
  }

  .variant-picker__swatch.is-active {
    border-color: var(--color-primary);
  }

  .variant-picker__swatch-color {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--color-surface-container-high);
    border: 1px solid var(--color-outline-variant);
  }

  .variant-picker__chip {
    padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 2);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .variant-picker__chip:hover {
    background-color: var(--color-surface-container);
  }

  .variant-picker__chip.is-active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .variant-picker__value-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .variant-picker__chip:disabled:hover {
    background-color: transparent;
  }

  .variant-picker__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-variant-picker]').forEach((picker) => {
    const json = picker.querySelector('[data-variant-picker-json]');
    const variants = JSON.parse(json.textContent);
    const optionGroups = Array.from(picker.querySelectorAll('[data-variant-option]'));
    const selected = optionGroups.map((group) => {
      const active = group.querySelector('.variant-picker__value-button.is-active');
      return active ? active.dataset.optionValue : group.querySelector('.variant-picker__value-button').dataset.optionValue;
    });

    const form = picker.closest('.product-form') || document.querySelector('.product-form');
    const variantIdInput = form ? form.querySelector('[data-variant-id]') : null;
    const priceEl = document.querySelector('[data-product-price]');

    function findVariant(options) {
      return variants.find((variant) => variant.options.every((value, index) => value === options[index]));
    }

    function updatePrice(variant) {
      if (!priceEl || !variant) return;

      if (variant.compareAtPrice) {
        priceEl.innerHTML =
          '<span class="product__price-sale" data-price-sale>' + variant.price + '</span>' +
          '<span class="product__price-compare" data-price-compare>' + variant.compareAtPrice + '</span>';
      } else {
        priceEl.innerHTML = '<span data-price-regular>' + variant.price + '</span>';
      }
    }

    function updateAvailability() {
      optionGroups.forEach((group, groupIndex) => {
        group.querySelectorAll('.variant-picker__value-button').forEach((button) => {
          const candidate = selected.slice();
          candidate[groupIndex] = button.dataset.optionValue;

          const variant = findVariant(candidate);
          const available = Boolean(variant && variant.available);

          button.disabled = !available;
          button.setAttribute('aria-disabled', String(!available));
        });
      });
    }

    function selectValue(groupIndex, value) {
      selected[groupIndex] = value;

      optionGroups[groupIndex].querySelectorAll('.variant-picker__value-button').forEach((button) => {
        const isActive = button.dataset.optionValue === value;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      const selectedValueEl = optionGroups[groupIndex]
        .closest('.variant-picker__option')
        .querySelector('[data-variant-selected-value]');
      if (selectedValueEl) selectedValueEl.textContent = value;

      const variant = findVariant(selected);
      updateAvailability();

      if (!variant) return;

      updatePrice(variant);

      if (variantIdInput) variantIdInput.value = variant.id;

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);

      document.dispatchEvent(new CustomEvent('pdp:variant-change', { detail: { variant } }));
    }

    optionGroups.forEach((group, groupIndex) => {
      group.querySelectorAll('.variant-picker__value-button').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          selectValue(groupIndex, button.dataset.optionValue);
        });
      });
    });

    updateAvailability();
  });
{% endjavascript %}
