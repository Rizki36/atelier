{% doc %}
  Renders a heading and a list of links sourced from a navigation menu, for
  use as one column of the footer's link columns.

  @example
  {% content_for 'block', type: 'footer-link-column', id: 'footer-link-column' %}
{% enddoc %}

<div class="footer-link-column" {{ block.shopify_attributes }}>
  <h4 class="footer-link-column__heading text-label-caps">{{ block.settings.heading }}</h4>
  <ul class="footer-link-column__list">
    {% for link in block.settings.menu.links %}
      <li><a class="footer-link-column__link text-label-sm" href="{{ link.url }}">{{ link.title }}</a></li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .footer-link-column__heading {
    color: var(--color-on-surface);
    margin-bottom: 24px;
  }

  .footer-link-column__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-link-column__link {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: color var(--motion-fade);
  }

  .footer-link-column__link:hover {
    color: var(--color-on-surface);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer_link_column",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Information"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
