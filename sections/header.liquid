{% comment %}
  Renders the site header: logo/wordmark, primary navigation, and utility
  icons (search, cart, account). Below the 1024px breakpoint the nav is
  replaced by a hamburger button that opens a full-screen dialog.
{% endcomment %}

<header class="header full-width">
  <div class="header__inner">
    <a href="{{ routes.root_url }}" class="header__brand">
      {% if section.settings.logo %}
        {% render 'image', image: section.settings.logo, width: 32, height: 32, class: 'header__logo' %}
      {% endif %}
      <span class="header__wordmark">{{ shop.name }}</span>
    </a>

    <nav class="header__nav" aria-label="{{ 'general.accessibility.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          class="header__nav-link text-label-caps{% if link.active %} header__nav-link--active{% endif %}"
          {% if link.active %}
            aria-current="page"
          {% endif %}
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__icon-button" aria-label="{{ 'general.accessibility.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      <button
        type="button"
        class="header__icon-button"
        aria-label="{{ 'general.accessibility.open_cart' | t }}"
        aria-controls="cart-drawer"
        data-cart-drawer-open
      >
        {% if cart.item_count > 0 %}
          <sup class="header__cart-count" data-cart-count>{{ cart.item_count }}</sup>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </button>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <button
        type="button"
        class="header__icon-button header__menu-button"
        aria-label="{{ 'general.accessibility.menu' | t }}"
        data-mobile-nav-open
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>
    </div>
  </div>

  <dialog class="header__mobile-nav" scroll-lock>
    <div class="header__mobile-nav-top">
      <span class="header__wordmark">{{ shop.name }}</span>
      <button
        type="button"
        class="header__icon-button"
        aria-label="{{ 'general.accessibility.close' | t }}"
        data-mobile-nav-close
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    <nav class="header__mobile-nav-links" aria-label="{{ 'general.accessibility.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="text-headline-sm{% if link.active %} header__nav-link--active{% endif %}">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <div class="header__mobile-nav-actions">
      <a href="{{ routes.search_url }}" class="header__icon-button" aria-label="{{ 'general.accessibility.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>
      <a href="{{ routes.cart_url }}" class="header__icon-button" aria-label="{{ 'general.accessibility.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}
    </div>
  </dialog>
</header>

{% stylesheet %}
  .header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--color-header-scrim);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .header__inner {
    height: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-gutter);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-on-surface);
    flex-shrink: 0;
  }

  .header__logo {
    width: 32px;
    height: 32px;
  }

  .header__wordmark {
    font-family: var(--font-headline);
    font-size: 24px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
  }

  .header__nav-link {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    padding-bottom: 2px;
    transition: color var(--motion-fade);
  }

  .header__nav-link:hover {
    color: var(--color-on-surface);
  }

  .header__nav-link--active {
    color: var(--color-on-surface);
    font-weight: 700;
    border-bottom: 1px solid var(--color-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .header__icon-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    text-decoration: none;
  }

  .header__icon-button:hover {
    color: var(--color-on-surface);
  }

  .header__icon-button svg {
    width: 20px;
    height: 20px;
  }

  .header__cart-count {
    position: absolute;
    top: -6px;
    right: -10px;
    min-width: 16px;
    padding: 0 3px;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .header__account {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
  }

  .header__account svg {
    width: 18px;
    height: 18px;
  }

  @media (min-width: 1024px) {
    .header__menu-button {
      display: none;
    }
  }

  .header__mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 60;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 20px;
    border: none;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-on-surface);
    opacity: 0;
    transition:
      opacity var(--motion-fade) allow-discrete,
      display var(--motion-fade) allow-discrete,
      overlay var(--motion-fade) allow-discrete;
  }

  .header__mobile-nav[open] {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .header__mobile-nav[open] {
      opacity: 0;
    }
  }

  .header__mobile-nav::backdrop {
    background: transparent;
  }

  @media (min-width: 1024px) {
    .header__mobile-nav {
      display: none !important;
    }
  }

  .header__mobile-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .header__mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 40px;
  }

  .header__mobile-nav-links a {
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .header__mobile-nav-links a.header__nav-link--active {
    font-weight: 700;
  }

  .header__mobile-nav-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: auto;
    padding-top: 40px;
    border-top: 1px solid var(--color-outline-variant);
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.header').forEach((header) => {
    const dialog = header.querySelector('.header__mobile-nav');
    const openButton = header.querySelector('[data-mobile-nav-open]');
    const closeButton = header.querySelector('[data-mobile-nav-close]');

    if (!dialog || !openButton) return;

    openButton.addEventListener('click', () => dialog.showModal());
    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });

  document.querySelectorAll('[data-cart-drawer-open]').forEach((button) => {
    button.addEventListener('click', () => {
      document.getElementById('cart-drawer')?.showModal();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
