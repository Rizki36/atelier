{% comment %}
  Renders a header row (heading + "explore all" link) above a responsive
  grid of merchant-editable category-card blocks (1 column on mobile, 3 on
  desktop, with the second card offset for an asymmetrical layout).
{% endcomment %}

<section class="categories" aria-labelledby="categories-heading">
  <div class="categories__header">
    <h2 id="categories-heading" class="categories__heading text-headline-md">{{ section.settings.heading }}</h2>
    {% if section.settings.explore_all_label != blank %}
      <a href="{{ section.settings.explore_all_link }}" class="categories__explore text-label-caps">
        {{ section.settings.explore_all_label }}
        {{ 'icon-arrow-right.svg' | inline_asset_content }}
      </a>
    {% endif %}
  </div>

  <div class="categories__grid">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .categories {
    padding-block: var(--spacing-section-gap);
  }

  .categories__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 64px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .categories__heading {
    color: var(--color-on-surface);
  }

  .categories__explore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: color var(--motion-fade);
  }

  .categories__explore:hover {
    color: var(--color-primary);
  }

  .categories__explore svg {
    width: 16px;
    height: 16px;
    transition: transform 300ms ease;
  }

  .categories__explore:hover svg {
    transform: translateX(4px);
  }

  .categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 768px) {
    .categories__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .categories__grid > :nth-child(2) .category-card {
      transform: translateY(48px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.curated_categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Curated Categories"
    },
    {
      "type": "text",
      "id": "explore_all_label",
      "label": "t:labels.explore_all_label",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "explore_all_link",
      "label": "t:labels.explore_all_link",
      "default": "/collections/all"
    }
  ],
  "blocks": [{ "type": "category-card" }],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.curated_categories",
      "blocks": [
        { "type": "category-card", "settings": { "title": "Outerwear" } },
        { "type": "category-card", "settings": { "title": "Essentials" } },
        { "type": "category-card", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
