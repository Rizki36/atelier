{% comment %}
  Renders a horizontally-scrollable "Trending Now" product slider, sourced
  from a merchant-selected collection. Renders nothing until a collection
  with at least one product is configured.
{% endcomment %}

<section class="trending-now full-width" aria-labelledby="trending-now-heading">
  {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
    <div class="trending-now__header">
      <div class="trending-now__header-inner">
        <h2 id="trending-now-heading" class="trending-now__heading text-headline-md">{{ section.settings.heading }}</h2>

        {% if section.settings.collection.products.size > 1 %}
          <div class="trending-now__nav">
            <button type="button" class="trending-now__nav-btn" data-slider-prev aria-label="{{ 'general.accessibility.previous' | t }}">
              {{ 'icon-arrow-left.svg' | inline_asset_content }}
            </button>
            <button type="button" class="trending-now__nav-btn" data-slider-next aria-label="{{ 'general.accessibility.next' | t }}">
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="trending-now__track" data-slider-track>
      {% for product in section.settings.collection.products limit: section.settings.product_limit %}
        <div class="trending-now__card">
          <a href="{{ product.url }}" class="trending-now__card-link">
            <div class="trending-now__card-image">
              {% if product.featured_image %}
                {% render 'image', image: product.featured_image, width: 640 %}
              {% endif %}

              {% if product.tags contains 'New' %}
                <div class="trending-now__badge-wrap">
                  <span class="trending-now__badge text-label-caps">{{ 'products.new_badge' | t }}</span>
                </div>
              {% endif %}
            </div>

            <div class="trending-now__info">
              <div>
                <h3 class="trending-now__title text-body-md">{{ product.title }}</h3>
                {% if product.type != blank %}
                  <p class="trending-now__variant text-label-sm">{{ product.type }}</p>
                {% endif %}
              </div>
              <span class="trending-now__price text-body-md">{{ product.price | money }}</span>
            </div>
          </a>

          <button type="button" class="trending-now__wishlist" aria-label="{{ 'general.accessibility.add_to_wishlist' | t }}">
            {{ 'icon-heart.svg' | inline_asset_content }}
          </button>
        </div>
      {% endfor %}

      <div class="trending-now__spacer" aria-hidden="true"></div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .trending-now {
    padding-block: var(--spacing-section-gap);
    background: var(--color-secondary-container-glass);
  }

  .trending-now__header {
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-bottom: 48px;
  }

  .trending-now__header-inner {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .trending-now__heading {
    color: var(--color-on-surface);
  }

  .trending-now__nav {
    display: flex;
    gap: 16px;
  }

  .trending-now__nav-btn {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-outline);
    background: none;
    color: var(--color-on-surface);
    cursor: pointer;
    transition: background-color var(--motion-fade);
  }

  .trending-now__nav-btn:hover {
    background: var(--color-surface-dim);
  }

  .trending-now__nav-btn svg {
    width: 20px;
    height: 20px;
  }

  .trending-now__track {
    display: flex;
    gap: var(--spacing-gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-inline: var(--page-margin);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .trending-now__track::-webkit-scrollbar {
    display: none;
  }

  .trending-now__card {
    position: relative;
    flex-shrink: 0;
    width: 280px;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .trending-now__card {
      width: 320px;
    }
  }

  .trending-now__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .trending-now__card-image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 24px;
    background: var(--color-surface-container);
  }

  .trending-now__card-image .image {
    width: 100%;
    height: 100%;
  }

  .trending-now__card-image .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75);
    transition: transform 500ms ease;
  }

  .trending-now__card:hover .trending-now__card-image img {
    transform: scale(1.05);
  }

  .trending-now__badge-wrap {
    position: absolute;
    top: 16px;
    left: 16px;
  }

  .trending-now__badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-surface-glass);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface);
    text-transform: uppercase;
  }

  .trending-now__wishlist {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--color-surface);
    color: var(--color-on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    opacity: 0;
    cursor: pointer;
    transition: opacity 300ms ease, color var(--motion-fade);
  }

  .trending-now__card:hover .trending-now__wishlist {
    opacity: 1;
  }

  .trending-now__wishlist:hover {
    color: var(--color-primary);
  }

  .trending-now__wishlist svg {
    width: 20px;
    height: 20px;
  }

  .trending-now__info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .trending-now__title {
    color: var(--color-on-surface);
    font-weight: 500;
  }

  .trending-now__variant {
    color: var(--color-on-surface-variant);
    margin-top: 4px;
  }

  .trending-now__price {
    color: var(--color-on-surface);
    white-space: nowrap;
  }

  .trending-now__spacer {
    flex-shrink: 0;
    width: 16px;
  }

  @media (min-width: 768px) {
    .trending-now__spacer {
      width: 32px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.trending-now').forEach((section) => {
    const track = section.querySelector('[data-slider-track]');
    const prevBtn = section.querySelector('[data-slider-prev]');
    const nextBtn = section.querySelector('[data-slider-next]');

    if (!track || !prevBtn || !nextBtn) return;

    const scrollAmount = 350;

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.trending_now",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:labels.product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:general.trending_now"
    }
  ]
}
{% endschema %}
